# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Modern secret key is supported instead of the legacy service role key.
SUPABASE_SECRET_KEY=
# NEXT_PUBLIC_SUPABASE_URL is also supported as the project URL.
# Enable only after applying the SQL migration and testing private storage.
ENQUIRIES_ENABLED=false
# Comma-separated Supabase Auth user UUIDs. Empty means no admin access.
ADMIN_USER_IDS=

# Commerce rollout flags. Keep false until migrations/provider credentials are verified.
COMMERCE_ORDERS_ENABLED=false
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
YASHFLOW_SYNC_ENABLED=false
YASHFLOW_API_URL=
YASHFLOW_API_SECRET=
SHIPPING_PROVIDER=
SHIPPING_API_KEY=

PROJECT_REQUESTS_ENABLED=false
SUPPORT_ENABLED=false
REVIEWS_ENABLED=false

ANALYTICS_ENABLED=false
